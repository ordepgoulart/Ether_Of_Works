<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tela"
    tools:context=".MainActivity">

    <!-- focusableInTouchMode: evita que a pesquisa abra o teclado sozinha ao iniciar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- cabeçalho amarelo (igual ao web) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cabecalho"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp"
            android:paddingEnd="20dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_logo">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logo do Ether of Works"
                    android:src="@drawable/ic_logo" />
            </FrameLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/app_name"
                    android:textColor="@color/azul_titulo"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slogan"
                    android:textColor="@color/azul_titulo"
                    android:textSize="11sp"
                    android:textStyle="bold|italic" />
            </LinearLayout>
        </LinearLayout>


        <!-- painel de vagas com a aba de pesquisa por cima -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_painel"
                android:orientation="vertical"
                android:paddingBottom="17dp"
                android:paddingEnd="19dp"
                android:paddingStart="14dp"
                android:paddingTop="36dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="4dp"
                    android:paddingStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vagas"
                        android:textColor="@color/texto_escuro"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvContador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_contador"
                        android:paddingBottom="2dp"
                        android:paddingEnd="8dp"
                        android:paddingStart="8dp"
                        android:paddingTop="1dp"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>


                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="2dp"
                    android:paddingEnd="4dp"
                    android:paddingStart="4dp"
                    android:text="Buscando vagas no servidor..."
                    android:textColor="@color/azul_marinho"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/lvVagas"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="10dp"
                        android:listSelector="@android:color/transparent"
                        android:paddingBottom="4dp"
                        android:scrollbars="none" />

                    <LinearLayout
                        android:id="@+id/layoutEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_vazio"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingBottom="34dp"
                        android:paddingEnd="20dp"
                        android:paddingStart="20dp"
                        android:paddingTop="30dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvEmptyTitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Nenhuma vaga por aqui"
                            android:textColor="@color/azul_marinho"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmptyTexto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Ainda não há vagas no panteão. Volte mais tarde."
                            android:textColor="@color/azul_marinho"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>


            <!-- abas amarelas que ficam por cima da borda do painel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtBusca"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@drawable/bg_aba"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_search"
                    android:hint="Pesquisar cargo, empresa ou cidade"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingBottom="3dp"
                    android:paddingEnd="15dp"
                    android:paddingStart="12dp"
                    android:textColor="@color/texto_escuro"
                    android:textColorHint="@color/marinho_suave"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnAtualizar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_botao_redondo"
                    android:contentDescription="Atualizar a lista de vagas"
                    android:paddingBottom="3dp"
                    android:paddingEnd="3dp"
                    android:src="@drawable/ic_atualizar" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
