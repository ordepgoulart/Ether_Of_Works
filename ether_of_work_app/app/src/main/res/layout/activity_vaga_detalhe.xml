<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tela"
    android:orientation="vertical"
    tools:context=".VagaDetalheActivity">

    <!-- barra do topo: voltar + título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/btnVoltar"
            style="@style/Ether.Botao.Voltar"
            android:text="‹ Voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="Detalhes da vaga"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp">

            <!-- cartão amarelo com o resumo da vaga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cartao_vaga"
                android:orientation="vertical"
                android:paddingBottom="19dp"
                android:paddingEnd="17dp"
                android:paddingStart="20dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/tvRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/marinho_suave"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="#V001" />

                <TextView
                    android:id="@+id/tvCargo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/texto_escuro"
                    android:textSize="22sp"
                    tools:text="Desenvolvedor Front-end" />

                <TextView
                    android:id="@+id/tvEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/texto_escuro"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Olimpo Tech" />

                <TextView
                    android:id="@+id/tvRemuneracao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/azul_marinho"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="R$ 5.000,00" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp">

                    <TextView
                        android:id="@+id/tvTipo"
                        style="@style/Ether.Etiqueta.Destaque"
                        tools:text="Nacional" />

                    <TextView
                        android:id="@+id/tvRegime"
                        style="@style/Ether.Etiqueta"
                        tools:text="CLT" />

                    <TextView
                        android:id="@+id/tvJornada"
                        style="@style/Ether.Etiqueta"
                        tools:text="40h semanais" />

                    <TextView
                        android:id="@+id/tvLocal"
                        style="@style/Ether.Etiqueta"
                        tools:text="Presidente Prudente - SP" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>


            <!-- painel azul com os requisitos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_painel"
                android:orientation="vertical"
                android:paddingBottom="23dp"
                android:paddingEnd="23dp"
                android:paddingStart="18dp"
                android:paddingTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Ether.Secao"
                        android:layout_width="wrap_content"
                        android:text="Formação" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_divisor" />
                </LinearLayout>


                <TextView
                    android:id="@+id/tvFormacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/texto_escuro"
                    android:textSize="15sp"
                    tools:text="Ciência da Computação" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Ether.Secao"
                        android:layout_width="wrap_content"
                        android:text="Pré-requisitos" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_divisor" />
                </LinearLayout>


                <TextView
                    android:id="@+id/tvPreRequisitos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/texto_escuro"
                    android:textSize="15sp"
                    tools:text="2 anos de experiência" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Ether.Secao"
                        android:layout_width="wrap_content"
                        android:text="Conhecimentos requeridos" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_divisor" />
                </LinearLayout>


                <TextView
                    android:id="@+id/tvConhecimentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/texto_escuro"
                    android:textSize="15sp"
                    tools:text="React, Git" />
            </LinearLayout>


            <Button
                android:id="@+id/btnInteresse"
                style="@style/Ether.Botao"
                android:layout_marginTop="22dp"
                android:text="Tenho interesse" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
