<?xml version="1.0" encoding="utf-8"?>
<!-- campo do formulário: branco com contorno marinho -->
<!-- o espaço à direita/abaixo é o mesmo da sombra do campo focado, para não "pular" ao focar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="2dp" android:color="@color/azul_marinho" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
