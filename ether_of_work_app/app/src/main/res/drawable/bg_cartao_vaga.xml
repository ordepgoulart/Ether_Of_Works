<?xml version="1.0" encoding="utf-8"?>
<!-- cartão amarelo da vaga, com faixa lateral e sombra "dura" (igual ao web) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/azul_marinho" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/amarelo_cartao" />
            <stroke android:width="2dp" android:color="@color/azul_marinho" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- faixa lateral amarelo-ouro -->
    <item
        android:width="6dp"
        android:bottom="5dp"
        android:gravity="start|fill_vertical"
        android:left="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/amarelo_aba" />
            <corners
                android:bottomLeftRadius="10dp"
                android:topLeftRadius="10dp" />
        </shape>
    </item>
</layer-list>
