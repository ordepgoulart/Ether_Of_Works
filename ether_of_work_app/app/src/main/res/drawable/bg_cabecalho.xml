<?xml version="1.0" encoding="utf-8"?>
<!-- cabeçalho amarelo em forma de pílula -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- sombra "dura" deslocada, sem desfoque (igual ao web) -->
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/azul_marinho" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/amarelo_aba" />
            <stroke android:width="2dp" android:color="@color/azul_marinho" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
