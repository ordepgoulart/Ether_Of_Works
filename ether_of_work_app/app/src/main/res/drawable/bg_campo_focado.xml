<?xml version="1.0" encoding="utf-8"?>
<!-- campo com foco: sombra amarela (igual ao :focus do web) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/amarelo_aba" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="2dp" android:color="@color/azul_marinho" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
