<?xml version="1.0" encoding="utf-8"?>
<!-- painel azul onde ficam as vagas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- sombra "dura" deslocada, sem desfoque (igual ao web) -->
    <item android:left="5dp" android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/azul_marinho" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/azul_painel" />
            <stroke android:width="2dp" android:color="@color/azul_marinho" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
