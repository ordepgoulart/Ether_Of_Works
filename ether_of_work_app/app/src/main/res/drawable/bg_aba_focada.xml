<?xml version="1.0" encoding="utf-8"?>
<!-- aba de pesquisa com foco: amarelo mais claro -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/azul_marinho" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/amarelo_aba_claro" />
            <stroke android:width="2dp" android:color="@color/azul_marinho" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
