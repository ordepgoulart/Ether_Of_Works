<?xml version="1.0" encoding="utf-8"?>
<!-- botão branco -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- sombra "dura" deslocada, sem desfoque (igual ao web) -->
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/azul_marinho" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="2dp" android:color="@color/azul_marinho" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
