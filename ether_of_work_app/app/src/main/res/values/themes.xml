<resources>
    <style name="Ether" />
    <!-- tema base: sempre claro, as cores do Ether of Works não mudam no modo escuro -->
    <style name="Base.Theme.EtherOfWork" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/azul_marinho</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/amarelo_aba</item>
        <item name="colorAccent">@color/azul_marinho</item>
        <item name="android:windowBackground">@color/azul_fundo</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.EtherOfWork" parent="Base.Theme.EtherOfWork" />

    <!-- etiquetas cinzas dos cartões (iguais às do web) -->
    <style name="Ether.Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_etiqueta</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/texto_etiqueta</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- etiqueta azul do tipo da empresa (Nacional / Internacional) -->
    <style name="Ether.Etiqueta.Destaque">
        <item name="android:background">@drawable/bg_etiqueta_destaque</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- título de seção: texto marinho em caixa alta -->
    <style name="Ether.Secao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/azul_marinho</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- rótulo acima dos campos do formulário -->
    <style name="Ether.Rotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/texto_escuro</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- campo branco com contorno marinho -->
    <style name="Ether.Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:textColor">@color/texto_escuro</item>
        <item name="android:textColorHint">@color/marinho_suave</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- botão amarelo principal ("Tenho interesse", "Enviar interesse") -->
    <style name="Ether.Botao" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_botao_amarelo</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/texto_escuro</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- botão branco "Voltar" -->
    <style name="Ether.Botao.Voltar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">19dp</item>
        <item name="android:background">@drawable/bg_botao_branco</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
